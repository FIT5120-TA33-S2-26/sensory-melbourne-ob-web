# Public hostname pointing to the EC2 Elastic IP. A free option is
# YOUR_ELASTIC_IP.sslip.io, for example 3.24.10.20.sslip.io.
APP_DOMAIN=replace-with-your-domain.example

# Rotate the previously exposed ORS key before deployment.
ORS_API_KEY=replace_with_new_openrouteservice_key

POSTGRES_USER=ta33
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=ta33
